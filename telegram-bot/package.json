{
  "name": "volonte-asistan",
  "version": "1.0.0",
  "description": "VOLONTE Telegram asistanı (Cloudflare Worker)",
  "scripts": {
    "test": "node --test test.mjs test-selin.mjs test-depo.mjs test-sami.mjs test-uretim.mjs test-pelin.mjs test-venom.mjs test-zincir.mjs",
    "build": "esbuild worker.js --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --minify-syntax --minify-whitespace --outfile=dist/worker.js",
    "build:kemal": "esbuild kemal-giris.js --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --minify-syntax --minify-whitespace --external:cloudflare:workers --outfile=dist/kemal.js",
    "build:selin": "esbuild selin-giris.js --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --minify-syntax --minify-whitespace --external:cloudflare:workers --outfile=dist/selin.js",
    "build:sami": "esbuild sami-giris.js --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --minify-syntax --minify-whitespace --external:cloudflare:workers --outfile=dist/sami.js",
    "build:pelin": "esbuild pelin-giris.js --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --minify-syntax --minify-whitespace --external:cloudflare:workers --outfile=dist/pelin.js",
    "build:venom": "esbuild venom-giris.js --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --target=es2022 --minify-syntax --minify-whitespace --external:cloudflare:workers --outfile=dist/venom.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "type": "module",
  "private": true
}
